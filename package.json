{
  "name": "concours-authentique-homme",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme du concours AUTHENTIQUE HOMME — Ministère Porteur d’Amour",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/translations": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@vercel/blob": "2.3.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.82.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
