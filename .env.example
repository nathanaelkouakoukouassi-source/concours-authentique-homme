# Copier en .env pour le développement local. Sur Vercel : Settings → Environment Variables.

# Base de données MongoDB (ajoutée automatiquement par l'intégration MongoDB Atlas de Vercel)
MONGODB_URI=mongodb://127.0.0.1/concours-authentique-homme

# Clé secrète Payload : une longue chaîne aléatoire (ex. générée sur https://1password.com/password-generator)
PAYLOAD_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Stockage des photos (ajouté automatiquement par Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Adresse publique du site, sans barre finale (ex. https://concours-authentique-homme.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lien vers le site du Ministère (affiché dans l'en-tête et le pied de page)
NEXT_PUBLIC_MINISTRY_URL=

# E-mails (Resend)
RESEND_API_KEY=
MINISTRY_FROM_EMAIL=Concours Authentique Homme <onboarding@resend.dev>
MINISTRY_DESTINATION_EMAIL=ministereporteurdamour@gmail.com
